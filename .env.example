# Kopyala: cp .env.example .env

# PostgreSQL. Yerelde docker compose ile: docker compose up -d
DATABASE_URL="postgresql://portfoy:portfoy@localhost:5432/portfoy?schema=public"

# Auth.js imza anahtarı. Yerelde bu haliyle çalışır; canlıya çıkarken üret: openssl rand -base64 32
AUTH_SECRET="yerel-gelistirme-icin-gecici-anahtar-uretimde-degistir"

# Müşteri linklerinin ve WhatsApp önizlemesinin tam adresi (sonunda / yok)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Yuklenen fotograf ve 360 kareler (varsayilan: ./uploads)
# UPLOAD_DIR=./uploads

# Bildirimleri disari iletmek icin (SMS/WhatsApp koprusu, n8n vb.): her bildirimde JSON POST edilir
# NOTIFY_WEBHOOK_URL=https://ornek.com/portfoy-bildirim
# NOTIFY_WEBHOOK_SECRET=gizli
